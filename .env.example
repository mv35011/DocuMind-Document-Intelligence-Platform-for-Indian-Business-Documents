# App & Environment
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind
DATABASE_READONLY_URL=postgresql+asyncpg://documind_readonly:readonly_pass@localhost:5432/documind

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO local / AWS S3 prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=documind-documents
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1

# Vector Search (Qdrant)
QDRANT_URL=http://localhost:6333

# Experiment Tracking (MLflow)
MLFLOW_TRACKING_URI=http://localhost:5001

# Security & Authentication
JWT_SECRET=documind-local-dev-jwt-secret-key-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Processing & Extraction Engine
EXTRACTOR_BACKEND=stub
OCR_ENGINE=tesseract
AUTO_APPROVE_THRESHOLD=0.88
MAX_UPLOAD_MB=20
MAX_PAGES=20

# Remote LLM (Groq Cloud / OpenAI Compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Self-Hosted VLM (vLLM on RunPod or Local)
VLM_BASE_URL=http://localhost:8000/v1
VLM_MODEL=Qwen/Qwen2-VL-2B-Instruct
